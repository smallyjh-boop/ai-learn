# ===== 后端 API =====
PORT=4000
# 不填则使用内存存储（仅开发用），生产环境必须填（docker compose 会自动设置）
DATABASE_URL=postgres://ailearn:ailearn@localhost:5432/ailearn
# 不填则限额计数用内存
REDIS_URL=redis://localhost:6379
# 生产环境必须改成长随机字符串：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# docker compose 里 Postgres 的密码
POSTGRES_PASSWORD=ailearn

# 网站对外地址：LINE 登录回调、Stripe 付款后跳回都用它；生产环境也只允许它跨域访问 API
WEB_URL=http://localhost:3000
# 额外允许跨域的地址，逗号分隔（可不填）
CORS_ORIGINS=

# AI：不填 key 时走 mock，方便本地开发不花钱（生产环境不填 key 会启动失败，除非显式 AI_PROVIDER=mock）
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_PRACTICE=claude-haiku-4-5
AI_MODEL_GRADER=claude-haiku-4-5
# 当天（曼谷时间）AI token 总量超过这个数时在日志里告警，0 = 不告警
AI_DAILY_TOKEN_ALERT=2000000
# 告警推送（AI 调用失败、当日用量超标）：Slack / Discord webhook 或自建中转；不填只写日志
ALERT_WEBHOOK_URL=

# 每日练习次数上限
QUOTA_FREE_PER_DAY=5
QUOTA_PRO_PER_DAY=50

# 登录（在各平台后台申请）
# LINE Developers → LINE Login channel；回调地址登记为 <WEB_URL>/auth/line
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Google Cloud → OAuth 客户端 ID（Web）；授权的 JavaScript 来源填 WEB_URL。多个用逗号分隔，第一个给网站用
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# 网站付款（Stripe）：不填 STRIPE_SECRET_KEY 则价格页改为收集邮箱
STRIPE_SECRET_KEY=
# Stripe 后台 → Webhooks，地址 <API地址>/webhooks/stripe，事件：checkout.session.completed、customer.subscription.*
STRIPE_WEBHOOK_SECRET=
# Stripe 后台建好的订阅价格 ID（price_...）
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# App 内购（Android/iOS，以后用）
REVENUECAT_WEBHOOK_TOKEN=

# ===== 前端（构建时写进网页，改了要重新构建） =====
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
EXPO_PUBLIC_API_URL=http://localhost:4000
