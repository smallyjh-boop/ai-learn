# ===== 后端 API =====
PORT=4000
# 不填则使用内存存储（仅开发用），正式环境必须填
DATABASE_URL=postgres://ailearn:ailearn@localhost:5432/ailearn
# 不填则限额计数用内存
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string

# AI 网关：不填 key 时走 mock，方便本地开发不花钱
AI_PROVIDER=anthropic            # anthropic | openai | mock
ANTHROPIC_API_KEY=
AI_MODEL_PRACTICE=claude-haiku-4-5
AI_MODEL_GRADER=claude-haiku-4-5

# 每日练习次数上限
QUOTA_FREE_PER_DAY=5
QUOTA_PRO_PER_DAY=50

# 登录（你自己去各平台申请）
GOOGLE_CLIENT_ID=
LINE_CHANNEL_ID=
APPLE_BUNDLE_ID=

# 订阅
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_TOKEN=

# ===== 前端 =====
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
