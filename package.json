{
  "name": "ai-learn",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @ai-learn/api dev",
    "dev:web": "pnpm --filter @ai-learn/web dev",
    "dev:mobile": "pnpm --filter @ai-learn/mobile start",
    "build": "pnpm -r --filter ./packages/** --filter ./apps/api --filter ./apps/web build",
    "typecheck": "pnpm -r typecheck",
    "content:check": "pnpm --filter @ai-learn/content check"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
